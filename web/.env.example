# undercover（卧底局）合约部署后填地址
NEXT_PUBLIC_GAME_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# 身份合约（灵魂绑定战绩身份）部署后填地址
NEXT_PUBLIC_IDENTITY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# 服务端专用：代写铸造身份时用的 operator 私钥（禁加 NEXT_PUBLIC_ 前缀，勿提交）
OPERATOR_PRIVATE_KEY=

# GenLayer Studionet RPC
NEXT_PUBLIC_RPC_URL=https://studio.genlayer.com/api

# 生产（Vercel serverless）需要：Upstash Redis 存房间状态
# 本地 `npm run dev` 可留空（自动回退到单进程内存）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
